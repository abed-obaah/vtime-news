# Root .htaccess for shared hosting (cPanel) where the domain's document root
# is the project folder instead of public/. Every request is passed internally
# to public/, so app code, .env, vendor/, storage/ etc. are never served directly.
#
# If you can point the domain's Document Root at public/ instead, this file
# is not needed.
#
# CORS is handled by Laravel (config/cors.php), not here. Setting the headers
# in both places would send Access-Control-Allow-Origin twice, and browsers
# reject that.

Options -Indexes

# Block direct access to dotfiles (.env, .git, ...) and archives / SQL dumps
# as a second safeguard. .well-known is left open for SSL validation.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule \.(zip|tar|gz|sql|log|bak)$ - [F,L,NC]

    # Pass the Authorization header through (needed for API bearer tokens).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Send everything else to Laravel's public/ folder internally.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "alt-php84" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
