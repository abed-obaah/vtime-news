# PulseNews front-end configuration
# Point this at wherever the Laravel API is served from.
VITE_API_URL=http://localhost:8000/api

# Public origin, used for canonical URLs and share links
VITE_SITE_URL=http://localhost:8000

# Social profiles. Leave any blank and that link is hidden rather than dead.
VITE_SOCIAL_X=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_YOUTUBE=
